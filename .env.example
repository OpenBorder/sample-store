# Local tutorial setup: fill in only this Open Border Test key pair, then run `npm start`.
# The local server stays on 127.0.0.1 and permits one in-memory Test checkout per restart.
OB_SECRET_KEY=sk_test_...
OB_PUBLISHABLE_KEY=pk_test_...

# Hosted deployment settings below are not required by the local tutorial.
# Global UTC-day transaction ceiling. Exact integers from 0 through 50 are accepted.
# Keep this at 0 while proving durable storage, cap indexes, and authentic webhook readiness.
DEMO_TRANSACTION_CAP=0

# Hosted mode is pinned to the production-dashboard Sandbox rail. Local mode uses this default.
OB_API_URL=https://api-sandbox.openborderpayments.com

# Durable order and authentic webhook prerequisites. Values belong only in the hosting platform.
DATABASE_URL=
OB_WEBHOOK_SECRET=
ORDER_REFERENCE_HMAC_SECRET=

# Port for the local server (defaults to 4000).
# PORT=4000
