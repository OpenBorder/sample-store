# Transaction routes are disabled unless this is explicitly true. Keep it false until durable
# storage, authentic webhooks, and separate provider-delivery approval are all in place.
DEMO_TRANSACTIONS_ENABLED=false

# Open Border Test credentials. Do not create or rotate these as part of a code deployment.
OB_SECRET_KEY=sk_test_...
OB_PUBLISHABLE_KEY=pk_test_...

# Hosted mode is pinned to the production-dashboard Sandbox rail.
OB_API_URL=https://api-demo.openborderpayments.com

# Durable order and authentic webhook prerequisites. Values belong only in the hosting platform.
DATABASE_URL=
OB_WEBHOOK_SECRET=
ORDER_REFERENCE_HMAC_SECRET=

# Port for the local server (defaults to 4000).
# PORT=4000
