# Local tutorial setup: fill in any paired Open Border Test keys, then run `npm start`.
# The local server stays on 127.0.0.1 and permits one in-memory Test checkout per restart.
OB_SECRET_KEY=sk_test_...
OB_PUBLISHABLE_KEY=pk_test_...

# Hosted deployment settings below are not required by the local tutorial.
# Per-instance UTC-day transaction ceiling. Exact integers from 0 through 50 are accepted.
# Keep this at 0 while proving authentic webhook readiness and trusted provenance.
DEMO_TRANSACTION_CAP=0

# Hosted mode accepts an allowlisted Test-rail host. Local mode uses this default.
OB_API_URL=https://api-sandbox.openborderpayments.com

# Authentic webhook prerequisites. Values belong only in the hosting platform.
OB_WEBHOOK_SECRET=
ORDER_REFERENCE_HMAC_SECRET=

# Port for the local server (defaults to 4000).
# PORT=4000
